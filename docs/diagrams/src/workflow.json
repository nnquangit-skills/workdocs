    {
      "dot": "emerald",
      "title": "Write",
      "items": [
        "Existing pages are backed up, then written; managed sections only; assets copied when absent",
        "Diagrams, the animated flow and the step player are drawn from real call sites"
      ]
    },
    {
      "dot": "rose",
      "title": "Verify",
      "items": [
        "docs/ is served alone: console, requests, both themes, 375 px, navigation, markers",
